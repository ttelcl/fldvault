<mah:MetroWindow
    x:Class="KeyLoader.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:KeyLoader.Main"
    xmlns:serverwidget="clr-namespace:KeyLoader.Main.ServerWidget"
    xmlns:tabs="clr-namespace:KeyLoader.Main.TaskTab"
    xmlns:mzvlt="clr-namespace:KeyLoader.Main.MasterVaults"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding WindowTitle}"
    TitleCharacterCasing="Normal"
    ResizeMode="CanResizeWithGrip"
    Height="400" Width="640"
    MinHeight="150" MinWidth="200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem
                    Header="_New master key file..."
                    Command="{Binding CreateMasterFileCommand}">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Padding="5,0,0,0" Height="20" Width="25" Kind="FileStarOutline" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Header="_Open master key file..."
                    Command="{Binding OpenMasterFileCommand}">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Padding="5,0,0,0" Height="20" Width="25" Kind="FileDocumentArrowRightOutline" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem
                    Header="E_xit"
                    Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <iconPacks:PackIconMaterial Padding="5,0,0,0" Height="20" Width="25" Kind="ExitToApp" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <!-- Reminder: The panel of a StatusBar is a DockPanel, so you can use DockPanel.Dock! -->
            <StatusBarItem DockPanel.Dock="Right" Padding="1,0">
                <!-- Space for grip -->
                <TextBlock Text="" Width="15"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="1,0">
                <Border
                    BorderThickness="1"
                    Padding="2,1"
                    BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}">
                    <TextBlock Text="{Binding StatusMessage}"/>
                </Border>
            </StatusBarItem>
        </StatusBar>
        <!-- Control center: -->
        <Border
            DockPanel.Dock="Top"
            MinHeight="40"
            BorderThickness="1"
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Background="{DynamicResource MahApps.Brushes.Accent4}">
            <DockPanel>
                <!-- Server status -->
                <serverwidget:ServerWidgetView
                    DockPanel.Dock="Right"
                    DataContext="{Binding ServerWidget}"/>
                <Button
                    DockPanel.Dock="Left"
                    Margin="5,3"
                    Padding="5,0"
                    mah:ControlsHelper.CornerRadius="14"
                    mah:ControlsHelper.MouseOverBorderBrush="White"
                    Command="{Binding CreateMasterFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="5,0"
                            Height="20" Width="20"
                            Kind="FileStarOutline" />
                        <TextBlock
                            Margin="5,0,10,0"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Text="New..."/>
                    </StackPanel>
                </Button>
                <Button
                    DockPanel.Dock="Left"
                    Margin="5,3"
                    Padding="5,0"
                    mah:ControlsHelper.CornerRadius="14"
                    mah:ControlsHelper.MouseOverBorderBrush="White"
                    Command="{Binding OpenMasterFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="5,0"
                            Height="20" Width="20"
                            Kind="FileDocumentArrowRightOutline" />
                        <TextBlock
                            Margin="5,0,10,0"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Text="Open..."/>
                    </StackPanel>
                </Button>
                <!-- filler -->
                <Grid/>
            </DockPanel>
        </Border>
        <!-- Tab Pane -->
        <Border
            DockPanel.Dock="Top"
            MinHeight="30"
            BorderThickness="1,0,1,1"
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Background="{DynamicResource MahApps.Brushes.Control.Background}">
            <tabs:TabsPaneView DataContext="{Binding TabHost}"/>
        </Border>
        <!-- Tab frame and content -->
        <Border
            BorderThickness="1,0,1,1"
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Background="{DynamicResource MahApps.Brushes.Control.Background}">
            <tabs:TabHostView DataContext="{Binding TabHost}">
                <tabs:TabHostView.Resources>
                    <DataTemplate DataType="{x:Type mzvlt:MasterTabViewModel}">
                        <mzvlt:MasterTabView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type tabs:TaskTabBaseViewModel}">
                        <!-- intended as fallback, but that won't work this way -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="TaskTabBaseViewModel (implementation missing)"/>
                            <TextBlock Text="{Binding Title}"/>
                        </StackPanel>
                    </DataTemplate>
                </tabs:TabHostView.Resources>
            </tabs:TabHostView>
        </Border>
    </DockPanel>
</mah:MetroWindow>
