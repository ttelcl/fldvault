<mah:MetroWindow
    x:Class="KeyLoader.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:local="clr-namespace:KeyLoader.Main"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding WindowTitle}"
    TitleCharacterCasing="Normal"
    ResizeMode="CanResizeWithGrip"
    Height="300" Width="400"
    MinHeight="150" MinWidth="200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <!-- Reminder: The panel of a StatusBar is a DockPanel, so you can use DockPanel.Dock! -->
            <StatusBarItem DockPanel.Dock="Right" Padding="1,0">
                <!-- Space for grip -->
                <TextBlock Text="" Width="15"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="1,0">
                <Border
                    BorderThickness="1"
                    Padding="2,1"
                    BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}">
                    <TextBlock Text="{Binding StatusMessage}"/>
                </Border>
            </StatusBarItem>
        </StatusBar>
        <Grid DockPanel.Dock="Top" MinHeight="40">
            <!-- Space for control center -->
            <Border
                BorderThickness="1"
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                Background="{DynamicResource MahApps.Brushes.Accent4}">
                <!-- TBD -->
            </Border>
        </Grid>
        <Grid>
            <!-- Space for main content -->
            <Border
                BorderThickness="1"
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}">
                <!-- TBD -->
            </Border>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
