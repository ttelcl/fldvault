<UserControl
    x:Class="KeyLoader.Main.MasterVaults.EditKeyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.MasterVaults"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    d:DataContext="{d:DesignInstance local:ChildKeyViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d" 
    d:DesignHeight="60" d:DesignWidth="800">
    <Border
        BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
        BorderThickness="2"
        MinHeight="45"
        >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                BorderThickness="1"
                Grid.Column="0"
                >
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="12"
                    Margin="5,5,5,5"
                    Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                    Text="{Binding KeyId}"/>
            </Border>
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                Background="{DynamicResource MahApps.Brushes.Accent4}"
                BorderThickness="1"
                Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        Height="24" Width="24"
                        Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyIcon}" />
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        Height="24" Width="24"
                        Foreground="{Binding KeyInfoKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyInfoIcon}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
