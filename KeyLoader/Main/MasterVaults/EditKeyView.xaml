<UserControl
    x:Class="KeyLoader.Main.MasterVaults.EditKeyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.MasterVaults"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    d:DataContext="{d:DesignInstance local:ChildKeyViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d" 
    d:DesignHeight="60" d:DesignWidth="800">
    <Border
        BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
        BorderThickness="1"
        MinHeight="45"
        >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                BorderThickness="1"
                Grid.Column="0"
                >
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="12"
                    Margin="5,5,5,5"
                    Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                    Text="{Binding KeyId}"/>
            </Border>
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                Background="{DynamicResource MahApps.Brushes.Accent4}"
                BorderThickness="1"
                Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        Height="24" Width="24"
                        Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyIcon}" />
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        Height="24" Width="24"
                        Foreground="{Binding KeyInfoKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyInfoIcon}" />
                </StackPanel>
            </Border>
            <!-- for now, leave column 2 unused -->
            <Border
                Grid.Column="3">
                <!-- with some help from Google AI -->
                <mah:DropDownButton
                    Margin="5,5"
                    BorderThickness="0"
                    >
                    <mah:DropDownButton.Icon>
                        <iconPacks:PackIconMaterial
                            Kind="DotsHorizontal"
                            Margin="5,0" />
                    </mah:DropDownButton.Icon>
                    <mah:DropDownButton.ItemsSource>
                        <CompositeCollection>
                            <MenuItem
                                Header="Copy Key Prefix"
                                Command="{Binding CopyPrefixCommand}"
                                Icon="{iconPacks:Material Kind=ContentCopy, Height=12, Width=12}"/>
                            <MenuItem
                                Header="Copy Full Key ID"
                                Command="{Binding CopyKeyIdCommand}"
                                Icon="{iconPacks:Material Kind=ContentCopy, Height=20, Width=20}"/>
                            <MenuItem
                                Header="Import from Key Server"
                                Command="{Binding TryLoadKeyCommand}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial
                                        Kind="TrayArrowDown"
                                        Foreground="#AAEEAA"
                                        Height="20"
                                        Width="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="Remove Passphrase Link" 
                                Command="{Binding RemoveKeyInfoCommand}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial
                                        Kind="KeyboardOffOutline"
                                        Foreground="#EE9966"
                                        Height="20"
                                        Width="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="Delete"
                                Command="{Binding DeleteKeyCommand}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial
                                        Kind="TrashCanOutline"
                                        Foreground="#FF6666"
                                        Height="20"
                                        Width="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </CompositeCollection>
                    </mah:DropDownButton.ItemsSource>
                </mah:DropDownButton>
            </Border>
        </Grid>
    </Border>
</UserControl>
