<UserControl
    x:Class="KeyLoader.Main.MasterVaults.EditKeyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.MasterVaults"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    d:DataContext="{d:DesignInstance local:ChildKeyViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d" 
    d:DesignHeight="60" d:DesignWidth="800">
    <Border
        BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
        BorderThickness="1"
        MinHeight="25"
        >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Status icons -->
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                Background="{DynamicResource MahApps.Brushes.Accent4}"
                BorderThickness="0"
                Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        ToolTip="Key known?"
                        Height="20" Width="20"
                        Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyIcon}" />
                    <iconPacks:PackIconMaterial
                        Margin="5,5"
                        VerticalAlignment="Stretch"
                        ToolTip="Passphrase link known?"
                        Height="20" Width="20"
                        Foreground="{Binding KeyInfoKnown, Converter={StaticResource TrueGreenFalseRed}}"
                        Kind="{Binding KeyInfoIcon}" />
                </StackPanel>
            </Border>
            <!-- Key Label -->
            <Border
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                BorderThickness="0"
                Grid.Column="1"
                >
                <TextBlock
                    FontFamily="Consolas"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Margin="5,5,5,5"
                    Foreground="{Binding KeyKnown, Converter={StaticResource TrueGreenFalseRed}}"
                    Text="{Binding KeyId}"/>
            </Border>
            <!-- Buttons and controls -->
            <Border
                Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Margin="5,5" Padding="5,2"
                        Style="{StaticResource MahApps.Styles.Button.Chromeless}"
                        Command="{Binding TryLoadKeyCommand}">
                        <iconPacks:PackIconMaterial
                            Kind="TrayArrowDown"
                            Height="20"
                            Width="20"/>
                    </Button>
                    <!-- DropDown 'menu', with some help from Google AI -->
                    <mah:DropDownButton
                        Margin="5,5"
                        BorderThickness="0"
                        >
                        <mah:DropDownButton.Icon>
                            <iconPacks:PackIconMaterial
                                Kind="DotsHorizontal"
                                Margin="5,0" />
                        </mah:DropDownButton.Icon>
                        <mah:DropDownButton.ItemsSource>
                            <CompositeCollection>
                                <MenuItem
                                    Header="Copy Key Prefix"
                                    Command="{Binding CopyPrefixCommand}"
                                    Icon="{iconPacks:Material Kind=ContentCopy, Height=12, Width=12}"/>
                                <MenuItem
                                    Header="Copy Full Key ID"
                                    Command="{Binding CopyKeyIdCommand}"
                                    Icon="{iconPacks:Material Kind=ContentCopy, Height=20, Width=20}"/>
                                <Separator />
                                <MenuItem
                                    Header="Import from Key Server"
                                    Command="{Binding TryLoadKeyCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial
                                            Kind="TrayArrowDown"
                                            Foreground="#AAEEAA"
                                            Height="20"
                                            Width="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Header="Push Key to Server"
                                    Command="{Binding TryPushKeyCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial
                                            Kind="TrayArrowUp"
                                            Height="20"
                                            Width="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Header="Remove Passphrase Link" 
                                    Command="{Binding RemoveKeyInfoCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial
                                            Kind="KeyboardOffOutline"
                                            Foreground="#EE9966"
                                            Height="20"
                                            Width="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Header="Delete"
                                    Command="{Binding DeleteKeyCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial
                                            Kind="TrashCanOutline"
                                            Foreground="#FF6666"
                                            Height="20"
                                            Width="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </CompositeCollection>
                        </mah:DropDownButton.ItemsSource>
                    </mah:DropDownButton>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
