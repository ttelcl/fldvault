<UserControl
    x:Class="KeyLoader.Main.MasterVaults.EditingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.MasterVaults"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    d:DataContext="{d:DesignInstance local:MasterVaultViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            BorderThickness="1"
            Grid.Row="0">
            <ItemsControl
                ItemsSource="{Binding Keys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate >
                        <local:EditKeyView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!-- edit buttons -->
        <Border
            MinHeight="25"
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Background="{DynamicResource MahApps.Brushes.Accent3}"
            BorderThickness="1"
            Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="5,5"
                    ToolTip="Paste key id, zkey, key bearing file, etc."
                    Command="{Binding TryPasteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Kind="ContentPaste"
                            Margin="5,0"
                            Height="24"
                            Width="24"/>
                        <TextBlock
                            Margin="10,5"
                            VerticalAlignment="Stretch"
                            Text="Paste Clipboard"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <!-- footer -->
        <Border
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Background="{DynamicResource MahApps.Brushes.Accent4}"
            BorderThickness="1"
            Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1">
                    <Button
                        Margin="5,5"
                        MinWidth="120"
                        Visibility="{Binding Owner.Modified, Converter={StaticResource VisibleIf}}"
                        Command="{Binding RevertCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Kind="SyncAlert"
                                Foreground="#EEAA44"
                                Margin="5,0"
                                Height="16"
                                Width="16"/>
                            <TextBlock
                                Margin="5,0"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                Text="Revert!"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border
                    Grid.Column="2">
                    <Button
                        MinWidth="120"
                        Margin="5,5"
                        Command="{Binding Owner.SaveAndViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Kind="{Binding Owner.SaveButtonIcon}"
                                Margin="5,0"
                                Height="16"
                                Width="16"/>
                            <TextBlock
                                Margin="5,0"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Owner.SaveButtonLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
