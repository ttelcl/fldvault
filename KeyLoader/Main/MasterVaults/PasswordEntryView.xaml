<UserControl
    x:Class="KeyLoader.Main.MasterVaults.PasswordEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.MasterVaults"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance local:PasswordEntryViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="450" d:DesignWidth="800">
    <!-- A small wrapper for a PasswordBox and Submit & Cancel buttons 
    to provide an MVVM friendly yet secure use of it -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <PasswordBox
            Grid.Row="0"
            Grid.Column="0"
            DataContext="{Binding PasswordTask}"
            KeyDown="Pass_KeyDown"
            mah:TextBoxHelper.Watermark="{Binding WaterMark}"
            DataContextChanged="Pass_DataContextChanged"
            PasswordChanged="Pass_PasswordChanged"/>
        <Button
            Grid.Row="0"
            Grid.Column="1"
            Padding="5,0"
            mah:ControlsHelper.MouseOverBorderBrush="White"
            Command="{Binding PasswordTask.SubmitCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Text="Submit"/>
                <iconPacks:PackIconMaterial
                    Width="16" Height="16"
                    Kind="KeyArrowRight" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
