<UserControl
    x:Class="KeyLoader.Main.TaskTab.TabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:KeyLoader.Main.TaskTab"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    MouseLeftButtonDown="TabView_MouseLeftButtonDown"
    MouseLeftButtonUp="TabView_MouseLeftButtonUp"
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance local:TaskTabBaseViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="450" d:DesignWidth="800">
    <!-- A pseudo-button acting as the actual "tab" -->
    <Grid 
        Background="{DynamicResource MahApps.Brushes.Control.Background}">
        <Border
            Background="{DynamicResource MahApps.Brushes.AccentBase}"
            CornerRadius="6"
            Margin="2,3"
            Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}">
            <TextBlock
                MaxWidth="100"
                MinWidth="50"
                Padding="10,3"
                Foreground="{DynamicResource MahApps.Brushes.Text}"
                TextAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"/>
        </Border>
        <Border
            Background="{DynamicResource MahApps.Brushes.Accent3}"
            Margin="2,3"
            CornerRadius="10"
            Visibility="{Binding IsActive, Converter={StaticResource VisibleIfNot}}">
            <TextBlock
                MaxWidth="100"
                MinWidth="50"
                Padding="10,3"
                Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                TextAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"/>
        </Border>
        <Border
            BorderThickness="3"
            Margin="2,3"
            CornerRadius="10"
            BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
            Visibility="{Binding IsClicking, Converter={StaticResource VisibleIf}}">
            
        </Border>
    </Grid>
</UserControl>
